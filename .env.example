# Only needed once you have a custom domain. Without it, metadataBase falls back to
# VERCEL_PROJECT_PRODUCTION_URL (injected automatically by Vercel), then to localhost.
# Absolute URLs matter: social scrapers ignore relative OG image paths.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional. Raises the GitHub API rate limit (60/hr unauthenticated) for the Activity section.
# Read on the server only — it never reaches the browser.
GITHUB_TOKEN=
